# Zambia Integrated Digital ID & Civil Registry Ecosystem

# Security Keys
# HSM (Hardware Security Module) Path
HSM_MODULE_PATH=/opt/hsm/lib/libcsPKCS11.so
HSM_PIN=123456

# Database Passwords
POSTGRES_USER=zidcr_admin
POSTGRES_PASSWORD=super_secure_postgres_password
POSTGRES_DB=zidcr_db

NEO4J_AUTH=neo4j/super_secure_neo4j_password

# JWT & Encryption
JWT_SECRET_KEY=generate_a_secure_256_bit_base64_encoded_key_here
AES_ENCRYPTION_KEY=generate_a_secure_256_bit_key_for_at_rest_encryption

# Service Ports
CORE_ID_PORT=8080
BIOMETRIC_PORT=8000
GSB_PORT=8081
ADMIN_DASHBOARD_PORT=3000

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=secure_rabbitmq_password
